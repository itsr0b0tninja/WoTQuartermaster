"""Temporary independent module discovery test. No game or database writes."""
MODULE={'id':'diagnostic','version':'0.1.0','api':1,'min_core':'0.3.2','dependencies':{}}

def build(window):
    w,l=page()
    heading(l,'Diagnostic','Diagnostic module v'+MODULE['version']+' · Independent module discovery test')
    f,v=panel()
    v.addWidget(label('New module installed successfully','Heading'))
    v.addWidget(label('This page and its sidebar entry are registered by the downloaded module, not by the core executable.',wrap=True))
    v.addWidget(label('Core version: '+window.runtime.core_version,wrap=True))
    v.addWidget(label('Module version: '+MODULE['version'],wrap=True))
    v.addWidget(label('This temporary page will be removed in the retirement test.',wrap=True))
    l.addWidget(f)
    l.addStretch(1)
    window.add_page('Diagnostic',w)

def register():
    return {'pages':[{'name':'Diagnostic','order':75,'build':build}]}
