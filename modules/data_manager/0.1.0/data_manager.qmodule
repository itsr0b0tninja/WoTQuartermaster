MAX_BYTES=8*1024*1024
RETRY=900
CHECK_INTERVAL=86400
ROOTS={'eu':'eu','na':'com','asia':'asia'}
# Public documented APIs and limited public metadata checks. Tanks.gg has no established bulk interface.
BASE_SOURCES=dict(REFERENCE['sources'])
BASE_SOURCES.pop('tanks_gg',None)
BASE_SOURCES.pop('current_patch',None)
BASE_SOURCES['client_mirror']='https://raw.githubusercontent.com/IzeBerg/wot-src/EU/.version_name'
BASE_SOURCES['unicum_specs']='https://unicum.gg/api/eu/tanks/specifications'
BASE_SOURCES['unicum_changes']='https://unicum.gg/api/eu/tanks/changes'
BASE_SOURCES['barracks']='https://worldoftanks.eu/en/news/general-news/currency-and-resources/'
HOSTS={'worldoftanks.eu','worldoftanks.com','worldoftanks.asia','developers.wargaming.net','raw.githubusercontent.com','unicum.gg','api.worldoftanks.eu','api.worldoftanks.com','api.worldoftanks.asia'}

def obj(x):return x if isinstance(x,dict) else {}
def canonical(x):return json.dumps(x,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False).encode('ascii')
def digest(x):return hashlib.sha256(x).hexdigest()
def read(path,limit=MAX_BYTES):
    if path.is_symlink() or not 0<path.stat().st_size<=limit:raise ValueError('Invalid source file')
    return json.loads(path.read_bytes())
def safe_url(url):
    u=urllib.parse.urlsplit(url)
    if u.scheme!='https' or u.hostname not in HOSTS or u.username or u.password or u.port not in (None,443):raise ValueError('Unapproved source')
    return url
class Redirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self,req,fp,code,msg,headers,newurl):
        safe_url(newurl)
        if urllib.parse.urlsplit(req.full_url).hostname!=urllib.parse.urlsplit(newurl).hostname:raise ValueError('Cross-host redirect rejected')
        return super().redirect_request(req,fp,code,msg,headers,newurl)
def fetch(url):
    request=urllib.request.Request(safe_url(url),headers={'User-Agent':'WoTQuartermaster/0.6.7 (public game data; no player records)','Accept':'application/json,text/html,text/plain;q=0.9','Cache-Control':'no-cache'})
    with urllib.request.build_opener(Redirect()).open(request,timeout=8) as f:
        safe_url(f.geturl());raw=f.read(MAX_BYTES+1)
    if not raw or len(raw)>MAX_BYTES:raise ValueError('Empty or oversized source')
    return raw

def source_registry(version,region,app_id=''):
    if region not in ROOTS:raise ValueError('Unsupported region')
    domain=ROOTS[region];src={k:v.replace('worldoftanks.eu','worldoftanks.'+domain).replace('/api/eu/','/api/'+region+'/') for k,v in BASE_SOURCES.items()}
    if region!='eu':src.pop('client_mirror',None)
    # Official patch index is always checked; unknown version-specific URLs are not invented.
    if region=='eu' and version==REFERENCE['target_client_build']:src['current_patch']=REFERENCE['sources']['current_patch']
    if re.fullmatch(r'[a-zA-Z0-9]{16,80}',app_id or ''):
        # Only a public application identifier and encyclopedia fields, never account ids or access tokens.
        src['wg_vehicles']='https://api.worldoftanks.'+domain+'/wot/encyclopedia/vehicles/?'+urllib.parse.urlencode({'application_id':app_id,'fields':'tank_id,tier,nation,modules_tree,next_tanks','limit':100,'page_no':1})
    return src

def native_identity(cat):
    m=obj(getattr(cat,'manifest',None));version=m.get('game_version');files=obj(m.get('files'))
    if not version or not files:return None
    hashes={k:obj(v).get('sha256') for k,v in files.items()}
    if any(not isinstance(h,str) or not re.fullmatch(r'[a-f0-9]{64}',h) for h in hashes.values()):return None
    return {'version':version,'hashes':hashes}

@lru_cache(maxsize=16)
def supplemental_manifest(path,stamp,identity_json):
    p=Path(path);m=read(p);i=json.loads(identity_json)
    if m.get('schema')!=1 or m.get('game_version')!=i['version'] or m.get('base_checksums')!=i['hashes'] or m.get('collection_finished') is not True or m.get('status') not in ('complete','partial') or m.get('collector_version') not in ('0.0.10','0.0.11'):
        raise ValueError('Supplemental identity mismatch')
    return m
@lru_cache(maxsize=512)
def supplemental_record(path,stamp,sha,identity_json,record_key):
    p=Path(path)
    if p.is_symlink() or p.stat().st_size>MAX_BYTES:raise ValueError('Unsafe record')
    raw=p.read_bytes()
    if digest(raw)!=sha:raise ValueError('Record checksum mismatch')
    r=json.loads(raw);i=json.loads(identity_json);d=obj(r.get('data'))
    if r.get('identity')!=i or r.get('category')+':'+str(r.get('key'))!=record_key or r.get('finished') is not True or digest(canonical(d))!=r.get('data_sha256'):raise ValueError('Record identity or payload mismatch')
    # Strip account/session observations from any static data shared with advisors.
    return {k:v for k,v in d.items() if k not in ('observed_account_key','observed_session','observed_at')}
def record(context,category,item_id):
    try:
        cat=context.catalogue;i=native_identity(cat)
        if not i or cat.folder is None:return None
        folder=Path(cat.folder)/'supplemental-audit-v1';p=folder/'manifest.json'
        if folder.is_symlink() or p.is_symlink():return None
        s=p.stat();m=supplemental_manifest(str(p),(s.st_size,s.st_mtime_ns),canonical(i).decode())
        k=category+':'+str(item_id);e=obj(obj(m.get('files')).get(k));filename=e.get('file','')
        if not re.fullmatch(r'[a-zA-Z0-9_-]+\.json',filename) or not re.fullmatch(r'[a-f0-9]{64}',str(e.get('sha256'))):return None
        p=folder/filename;s=p.stat();ident={'schema':m['schema'],'collector_version':m['collector_version'],'game_version':m['game_version'],'base_checksums':m['base_checksums']}
        d=supplemental_record(str(p),(s.st_size,s.st_mtime_ns),e['sha256'],canonical(ident).decode(),k)
        if category=='vehicle' and (str(d.get('vehicle_id'))!=str(item_id) or d.get('scope')!='isolated_stock_preview' or d.get('fit_scope')!='stock_preview_only_not_purchase_eligibility'):return None
        return d
    except (OSError,ValueError,KeyError,TypeError,AttributeError):return None

def reference(context):
    i=native_identity(context.catalogue)
    if not i or i['version']!=REFERENCE['target_client_build']:return None
    # The curated reference is bound to the exact native catalogue hashes, not merely a matching version name.
    if i['hashes']!=REFERENCE['base_checksums']:return None
    return REFERENCE

def safe_config(root):
    try:c=read(root/'settings.json',16384)
    except (OSError,ValueError):c={}
    region=c.get('region','eu');return (region if region in ROOTS else 'eu',str(c.get('wg_application_id','')))

def refresh_sources(root,identity,region,app_id='',getter=fetch,now=None,force=False):
    now=time.time() if now is None else now
    ident={'schema':1,'native':identity,'region':region,'manager_version':MODULE['version']}
    key=digest(canonical(ident));folder=root/'generations'/key;folder.mkdir(parents=True,exist_ok=True)
    if root.is_symlink() or folder.is_symlink() or not folder.resolve().is_relative_to(root.resolve()):raise ValueError('Unsafe data folder')
    state_path=folder/'status.json'
    try:state=read(state_path)
    except (OSError,ValueError):state={}
    if state.get('identity')!=ident:state={'identity':ident,'sources':{}}
    status=obj(state.get('sources'));registry=source_registry(identity['version'],region,app_id)
    # Keep an independently retriable check for each source. Do not mark a failed check as a successful refresh.
    for name,url in registry.items():
        prev=obj(status.get(name));is_good=prev.get('state') in ('checked','provisional')
        if not force and now-prev.get('attempted_at',0)<(CHECK_INTERVAL if is_good else RETRY) :continue
        try:
            raw=getter(url);h=digest(raw)
            entry={'attempted_at':now,'checked_at':now,'sha256':h,'changed':bool(prev.get('sha256') and prev.get('sha256')!=h),'state':'checked','verification':'document/source checked; semantic review required'}
            if name in ('unicum_specs','unicum_changes','wg_vehicles'):
                data=json.loads(raw);rows=data.get('results') if name=='unicum_specs' else data.get('versions') if name=='unicum_changes' else data.get('data')
                if not isinstance(rows,(list,dict)) or not rows or (name=='wg_vehicles' and data.get('status')!='ok'):raise ValueError('Invalid public API response')
                if name=='unicum_specs':
                    if not isinstance(rows,list) or any(not isinstance(x,dict) or type(obj(x.get('identity')).get('tankId')) is not int or not isinstance(x.get('specifications'),dict) for x in rows):raise ValueError('Invalid specifications schema')
                    ids=[x['identity']['tankId'] for x in rows]
                    if len(ids)!=len(set(ids)):raise ValueError('Duplicate vehicle IDs')
                # Save only candidate public data. Exact client/configuration provenance is not established.
                atomic_bytes(folder/(name+'-'+h+'.json'),raw);entry.update(state='provisional',verification='Public API observation; exact client/configuration not established',rows=len(rows))
            elif name=='client_mirror':
                version=raw.decode('utf-8').strip();entry.update(verification='Exact mirror build matches' if version==identity['version'] else 'Mirror build differs',mirror_version=version)
                if version!=identity['version']:entry['state']='provisional'
            status[name]=entry
        except Exception as exc:
            # Do not persist exception messages that may contain a configured API key.
            status[name]=dict(prev,state='retry',attempted_at=now,error=type(exc).__name__)
        state['sources']=status;atomic_bytes(state_path,canonical(state))
    if 'wg_vehicles' not in registry:status['wg_vehicles']={'state':'blocked','verification':'Registered Wargaming application ID required'}
    status['tanks_gg']={'state':'blocked','verification':'No approved machine data interface; no scraping'}
    state['sources']=status;state['updated_at']=now
    atomic_bytes(state_path,canonical(state))
    # This is an observation pointer, never permission to use stale data as current.
    atomic_bytes(root/'current.json',canonical({'identity':ident,'generation':key,'status':'checked_with_limitations'}))
    return state

def make_page(w):
    p=QWidget();lay=QVBoxLayout(p);heading(lay,'Data Manager','Version-aware native and external sources. All online requests are for public game data only.')
    w.dm_summary=label('Waiting for a matching game catalogue.',wrap=True);lay.addWidget(w.dm_summary)
    w.dm_details=label('',wrap=True);lay.addWidget(w.dm_details)
    w.dm_details.setTextFormat(Qt.TextFormat.PlainText)
    b=QPushButton('Check sources now');b.clicked.connect(lambda:refresh(w,True,manual=True));lay.addWidget(b);lay.addStretch(1);w.add_page('Data Manager',p)
def refresh(w,force=False,manual=False):
    # Called on the GUI thread. Network and file writes are exclusively in a separate worker.
    if not hasattr(w,'dm_summary') or not getattr(w,'model',None):return
    m=w.model;root=Path(m.root)/'data_manager';i=native_identity(m.garage_data.catalogue)
    if not i or m.state not in ('garage','closed','stale'):return
    key=(str(root.resolve()),digest(canonical(i)));job=getattr(w,'dm_job',None)
    if job and not job.is_alive():w.dm_job=None
    if getattr(w,'dm_result',None):
        result_key,state=w.dm_result;w.dm_result=None
        if result_key==key:
            w.dm_summary.setText(i['version']+' · '+str(len(REFERENCE['active_perks']))+' reviewed perk identities in the reference pack' if i['version']==REFERENCE['target_client_build'] else i['version']+' · reference pack requires review')
            w.dm_details.setText('\n'.join(k+': '+str(v.get('state'))+' — '+str(v.get('verification',v.get('error',''))) for k,v in sorted(obj(state.get('sources')).items())))
    if getattr(w,'dm_job',None):return
    if not manual and getattr(w,'dm_key',None)==key and time.monotonic()<getattr(w,'dm_next',0):return
    w.dm_key=key;w.dm_next=time.monotonic()+60;w.dm_summary.setText(i['version']+' · Checking source status…')
    def work():
        try:
            region,app=safe_config(root);state=refresh_sources(root,i,region,app,force=manual)
        except Exception as exc:state={'sources':{'manager':{'state':'retry','error':type(exc).__name__}}}
        w.dm_result=(key,state)
    w.dm_job=threading.Thread(target=work,name='Quartermaster public data sources',daemon=True);w.dm_job.start()
def reset(w):
    w.dm_key=None;w.dm_next=0

def register():
    return {'services':{'native_stock_preview':lambda context,vehicle_id:record(context,'vehicle',vehicle_id),'reviewed_data_reference':reference,'native_supplemental_record':record},'pages':[{'name':'Data Manager','order':75,'build':make_page}],'hooks':{'refresh':refresh,'reset':reset}}
