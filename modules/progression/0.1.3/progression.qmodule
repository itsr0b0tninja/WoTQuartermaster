# WoTQuartermaster Progression Advisor 0.1.3 - read-only, portable.
import math, statistics, json, os, re, time, hashlib, logging
from pathlib import Path
from bisect import bisect_left,bisect_right
from module_shared import obj, seq, key, name
MODULE={'id':'progression','version':'0.1.3','api':1,'min_core':'0.6.0','dependencies':{'research':'0.1.1','finance':'0.1.1','battle_performance':'0.1.3'}}
WEIGHTS={'Passive Scout':(35,40,15,0,0,5,5),'Active Scout':(30,25,35,0,0,5,5),'Hybrid Scout':(25,25,25,15,5,5,0),'Combat Scout':(20,15,25,25,10,5,0),'Flanker':(5,10,35,25,20,5,0),'Fire Support':(5,5,10,35,30,10,5),'Concealed Sniper':(5,30,5,25,30,0,5),'Brawler':(0,0,10,30,15,40,5),'Defensive Fighter':(5,5,5,25,15,30,15),'Artillery Support':(0,5,10,40,35,0,10)}
CATEGORIES=('Reconnaissance','Concealment','Mobility','Firepower','Gun handling','Protection','Flexibility')
MODES=('random_pvp','ai_or_mixed')
NATIONS=('USSR','Germany','USA','China','France','UK','Japan','Czechoslovakia','Sweden','Poland','Italy')
FORMULA=4
ROUTE_WEIGHTS=(45,30,5,15,5)
ENDGAME_TIERS=(10,11)
def number(x):
    return x if type(x) in (int,float) and math.isfinite(x) else None
def nonneg(x):
    v=number(x); return v if v is not None and v>=0 else None
def one(x):
    # Do not average distinct operating modes. First reported normal mode, if valid.
    return number(x[0]) if isinstance(x,list) and x else number(x)
def at(x,i):
    return number(x[i]) if isinstance(x,list) and len(x)>i else None
def neg(x): return -x if x is not None else None
def cash(x):
    if not isinstance(x,dict): return None
    if any(number(v) not in (None,0) for k,v in x.items() if k!='credits'): return None
    return nonneg(x.get('credits'))
def fmt(x):
    return 'Unknown' if x is None else f'{x:,.0f}' if type(x) in (int,float) else str(x)
def title(rows,k): return name(obj(rows.get(k)), 'Vehicle '+str(k))
def tier(v): return int(v['level']) if type(v.get('level')) is int else 0
def artillery(v): return str(v.get('type','')).lower()=='spg'
def regular(v):
    return 1<=tier(v)<=11 and str(v.get('type','')).lower() in ('lighttank','mediumtank','heavytank','at-spg','spg') and all(v.get(k) is False for k in ('isPremium','isSecret','isCollectible'))
def edges(v):
    return [(str(e[1]),e[0],tuple(str(p) for p in e[2:])) for e in seq(v.get('research_edges')) if isinstance(e,list) and len(e)>=2 and nonneg(e[0]) is not None]
def graph(rows):
    eligible={k for k,v in rows.items() if regular(v)}
    out={k:sorted({t for t,_,_ in edges(rows[k]) if t in eligible and tier(rows[t])>tier(rows[k]) and rows[t].get('nationID')==rows[k].get('nationID')}) for k in eligible}
    roots=sorted(k for k in eligible if tier(rows[k])==1)
    seen=set(roots); todo=roots[:]
    while todo:
        k=todo.pop()
        for t in out[k]:
            if t not in seen: seen.add(t); todo.append(t)
    return {k:[t for t in out[k] if t in seen] for k in seen}
def attributes(v,p,shots=None):
    p=obj(p); camo=obj(p.get('invisibilityStillFactor')); moving=obj(p.get('invisibilityMovingFactor'))
    return {'view':one(p.get('circularVisionRadius')),'still':number(camo.get('current')),'moving':number(moving.get('current')),'firecamo':number(camo.get('atShot')),
        'power':one(p.get('enginePowerPerTon')),'speed':at(p.get('speedLimits'),0),'reverse':at(p.get('speedLimits'),1),'traverse':one(p.get('chassisRotationSpeed')),
        'dpm':one(p.get('avgDamagePerMinute')),'pen':one(p.get('avgPiercingPower')),'alpha':one(p.get('avgDamage')),
        'accuracy':neg(one(p.get('shotDispersionAngle'))),'aim':neg(one(p.get('aimingTime'))),'velocity':number(obj(shots).get('speed')),
        'hp':one(p.get('maxHealth')),'hull':at(p.get('hullArmor'),0),'turret':at(p.get('turretArmor'),0),'side':at(p.get('hullArmor'),1),
        'depression':neg(at(p.get('pitchLimits'),0)),'guntraverse':one(p.get('turretRotationSpeed'))}
def groups(style):
    camouflage=(('still',60),('moving',25),('firecamo',15)) if style in ('Passive Scout','Concealed Sniper') else (('still',25),('moving',60),('firecamo',15)) if style in ('Active Scout','Combat Scout','Flanker') else (('still',40),('moving',40),('firecamo',20))
    # Missing terrain, burst, bloom and firing arc are intentionally not fabricated.
    return ((('view',100),),camouflage,(('power',30),('speed',25),('terrain',20),('traverse',15),('reverse',10)),(('dpm',35),('pen',35),('alpha',20),('burst',10)),(('accuracy',35),('aim',25),('bloom',25),('velocity',15)),(('hp',35),('hull',35),('turret',20),('side',10)),(('depression',40),('arc',35),('guntraverse',25)))
def percentile(values,x):
    if x is None or not values: return None
    if len(values)==1: return 50.0
    return max(0,min(100,100*(bisect_left(values,x)+(bisect_right(values,x)-bisect_left(values,x)-1)/2)/(len(values)-1)))
def category_scores(attrs,ref,style):
    scores=[]; coverage=[]
    for group in groups(style):
        items=[(percentile(ref.get(k,[]),attrs.get(k)),w) for k,w in group]
        valid=[(s,w) for s,w in items if s is not None]; total=sum(w for s,w in valid)
        scores.append(sum(s*w for s,w in valid)/total if total>=40 else None); coverage.append(total)
    w=WEIGHTS[style]; used=sum(a for a,s in zip(w,scores) if s is not None)
    overall=sum(a*s for a,s in zip(w,scores) if s is not None)/used if used>=75 else None
    return {'score':overall,'categories':scores,'coverage':sum(a*c for a,c in zip(w,coverage))/100,'available_fields':tuple(sorted(k for group in groups(style) for k,_ in group if attrs.get(k) is not None and ref.get(k)))}
def shot_for(g,gun):
    shots=seq(g.get(str(gun),{}).get('shots'))
    return next((s for s in shots if number(obj(s).get('defaultPortion')) is not None and s['defaultPortion']>0.5),None)
def catalogue_scores(rows,tree,gun_enrich):
    attrs={k:attributes(v,v.get('stock_parameters'),shot_for(gun_enrich,obj(obj(v.get('stock_modules')).get('gun')).get('compactDescr'))) for k,v in rows.items() if tier(v)>0}
    ref={}
    for k in tree:
        v=rows[k]; group=ref.setdefault((tier(v),artillery(v)),{})
        for f,x in attrs[k].items():
            if x is not None: group.setdefault(f,[]).append(x)
    for group in ref.values():
        for a in group.values(): a.sort()
    scores={}
    for k,a in attrs.items():
        v=rows[k]; group=ref.get((tier(v),artillery(v)),{})
        scores[k]={s:category_scores(a,group,s) for s in WEIGHTS if artillery(v)==(s=='Artillery Support')}
    return scores,ref
def unlocked_set(g):
    r=obj(g.section('research'))
    if not isinstance(r.get('unlocked_item_ids'),list) or not isinstance(r.get('initial_unlocks'),list): return None
    return set(map(str,r['unlocked_item_ids']+r['initial_unlocks']))
def live_edges(g):
    out={}
    for row in obj(obj(g.section('progression')).get('owned_vehicle_paths')).values():
        row=obj(row); v=key(row.get('vehicle_id'))
        for e in seq(row.get('edges')):
            if isinstance(e,dict) and e.get('target_id') is not None: out[(v,str(e['target_id']))]=e
    return out
def dependency_plan(rows,source,target,unlocked,live):
    # Min-cost alternatives with recursive prerequisites; no duplicate shared module research.
    by={}
    for t,x,ps in edges(rows.get(source,{})): by.setdefault(t,[]).append((x,ps))
    def solve(t,known,stack):
        if t in known: return []
        if t in stack: return None
        plans=[]
        for cost,ps in by.get(t,[]):
            planned=[]; seen=set(known); ok=True
            for p in ps:
                q=solve(p,seen,stack|{t})
                if q is None: ok=False; break
                planned+=q; seen.update(x['id'] for x in q)
            if not ok: continue
            e=obj(live.get((source,t))); adjusted=nonneg(obj(e.get('target')).get('blueprint_adjusted_xp'))
            price=adjusted if adjusted is not None else cost
            planned.append(dict(id=t,xp=price,source=source,discount_known=adjusted is not None or t not in rows))
            plans.append(planned)
        return min(plans,key=lambda q:(sum(x['xp'] for x in q),len(q))) if plans else None
    return solve(target,set(unlocked),set())
def price_for(g,rows,k,live=None):
    e=obj(obj(live).get('target'))
    for raw in (e.get('personal_discount_price'),e.get('buy'),obj(obj(g.section('current_shop_prices')).get('prices')).get(k),obj(rows.get(k)).get('default_buy')):
        x=cash(raw)
        if x is not None: return x
    return None
def stock_ids(row):
    return {str(v['compactDescr']) for v in obj(row.get('stock_modules')).values()
            if isinstance(v,dict) and v.get('compactDescr') is not None}

def route_candidates(rows,tree,scores,style,owned,unlocked,xps,g,live,crew):
    # Evaluate each canonical branch from its national root. Entry and fit are
    # independent: owning a tank never changes the stock suitability of a branch.
    available=set(owned)|set(unlocked); candidates=[]
    blocked=set(map(str,seq(obj(g.section('current_shop_prices')).get('vehicles_not_to_buy'))))|set(map(str,seq(obj(g.section('current_shop_prices')).get('hidden_item_ids'))))
    blocked-=set(owned)
    def score(k):
        return obj(obj(scores.get(k)).get(style)).get('score')
    domain=[tier(rows[k]) for k in tree if artillery(rows[k])==(style=='Artillery Support')]
    if not domain: return []
    # Production catalogues must reach X/XI. Small synthetic/partial catalogues
    # can be displayed but are explicitly excluded from sale decisions.
    horizon={t for t in ENDGAME_TIERS if t in domain} or {max(domain)}
    def walk(path):
        k=path[-1]
        if score(k) is not None and tier(rows[k]) in horizon: yield tuple(path)
        for t in tree.get(k,[]): yield from walk(path+[t])
    for root in sorted(k for k in tree if tier(rows[k])==1):
        for full in walk([root]):
            accessible=[i for i,k in enumerate(full) if k in available]
            if not accessible: continue
            entry=max(accessible)
            # Keep an owned direct predecessor for credit/crew planning.
            if entry>0 and full[entry] not in owned and full[entry-1] in owned:
                entry-=1
            path=list(full[entry:])
            if any(k in blocked for k in path): continue
            dest=full[-1]; end=score(dest)
            # Count every stage. Non-domain transitions and unavailable scores
            # are neutral/provisional rather than silently omitted.
            mids=[score(k) if score(k) is not None else 50 for k in full[:-1]]
            mid=statistics.mean(mids) if mids else end
            missing_fit=[k for k in full if artillery(rows[k])==(style=='Artillery Support') and score(k) is None]
            missing_xp=[]
            known=set(available); xp=0; credits=0; xp_complete=True; credit_complete=True
            for i,k in enumerate(path):
                if k not in owned:
                    v=price_for(g,rows,k,live.get((path[i-1],k)) if i else None)
                    if v is None: credit_complete=False
                    else: credits+=v
                if i:
                    source=path[i-1]
                    # Stock items of a simulated future purchase are available
                    # in that simulation only, not written to live unlocks.
                    known.update(stock_ids(rows[source]))
                    plan=dependency_plan(rows,source,k,known,live)
                    if plan is None:
                        xp_complete=False; missing_xp.append((source,k)); continue
                    source_xp=nonneg(xps.get(source))
                    if source in owned and source_xp is None and plan: xp_complete=False
                    xp+=max(0,sum(e['xp'] for e in plan)-(source_xp or 0))
                    known.update(e['id'] for e in plan)
            start=path[0]; progress=100*sum(k in available for k in full)/len(full)
            roles=seq(obj(rows[start].get('vehicle_type')).get('crewRoles'))
            matching=[c for c in crew if c.get('nationID')==rows[start].get('nationID') and c.get('isDismissed') is False and (c.get('isInTank') is False or str(c.get('native_vehicle_id'))==start)]
            used=set()
            for rr in roles:
                primary=rr[0] if isinstance(rr,list) and rr else None
                c=next((c for c in matching if c.get('role')==primary and c.get('invID') is not None and c.get('invID') not in used),None)
                if c: used.add(c['invID'])
            reuse=100*len(used)/len(roles) if roles else 0
            candidates.append(dict(path=path,full_path=list(full),destination=dest,start=start,end=end,mid=mid,progress=progress,xp=xp if xp_complete else None,credits=credits if credit_complete else None,reuse=reuse,missing_fit=missing_fit,missing_xp=missing_xp,grind=None))
    # Compare remaining costs only against routes ending at the same tier.
    bins={}
    for r in candidates:
        b=bins.setdefault(tier(rows[r['destination']]),[[],[]])
        if r['xp'] is not None: b[0].append(-r['xp'])
        if r['credits'] is not None: b[1].append(-r['credits'])
    for b in bins.values():
        for a in b: a.sort()
    for r in candidates:
        b=bins[tier(rows[r['destination']])]
        xx=percentile(b[0],-r['xp']) if r['xp'] is not None else None
        cc=percentile(b[1],-r['credits']) if r['credits'] is not None else None
        grind=((xx if xx is not None else 50)+(cc if cc is not None else 50))/2
        r['grind']=grind
        r['rank']=sum(w*r[k] for w,k in zip(ROUTE_WEIGHTS,('end','mid','progress','grind','reuse')))/100
    return sorted(candidates,key=lambda r:(-r['rank'],-tier(rows[r['destination']]),r['path']))

def select_progression(candidates,prior,owned,unlocked,rows,tree,style):
    # End-game comparison only. X and XI are separate cohorts; the highest
    # available cohort determines the career, including already owned endpoints.
    if not candidates: return None
    level=max(tier(rows[r['destination']]) for r in candidates)
    options=[r for r in candidates if tier(rows[r['destination']])==level]
    def best(options):
        return min(options,key=lambda r:(-r['rank'],r['full_path'])) if options else None
    top=best(options)
    p=obj(prior)
    if p.get('formula')!=FORMULA: return top
    previous=seq(p.get('full_path')); dest=p.get('destination')
    incumbent=best([r for r in options if r['destination']==dest and (not previous or r['full_path']==previous)])
    if incumbent and top['rank']-incumbent['rank']<5: return incumbent
    return top

def career_snapshot(route,owned):
    path=route['path']; pos=max((i for i,k in enumerate(path) if k in owned),default=-1)
    return dict(path=path,full_path=route['full_path'],destination=route['destination'],
                current=path[pos] if pos>=0 else None,next=path[pos+1] if pos+1<len(path) else None,formula=FORMULA)

def all_careers(rows,tree,scores,owned,known,xps,g,live,crew,previous):
    choices={}; alternatives={}; snapshots={}
    for style in WEIGHTS:
        candidates=route_candidates(rows,tree,scores,style,owned,known,xps,g,live,crew)
        alternatives[style]=candidates
        chosen=select_progression(candidates,previous.get(style),owned,known,rows,tree,style)
        if chosen:
            choices[style]=chosen
            snapshots[style]=career_snapshot(chosen,owned)
    return choices,alternatives,snapshots

def verified_money(x):
    if not isinstance(x,dict) or any(v is not None and (number(v) is None or v!=0) for k,v in x.items() if k!='credits'):
        return None
    return nonneg(x.get('credits'))

def config_fit(rows,refs,g,v,style,gun_enrich):
    cd=key(v.get('intCD')); cfg=obj(obj(g.section('configured_performance')).get(key(v.get('invID'))))
    if cd not in rows or key(cfg.get('vehicle_id'))!=cd or artillery(rows[cd])!=(style=='Artillery Support'): return None
    actual=obj(v.get('modules')); expected=obj(cfg.get('modules'))
    if not expected or any(key(expected.get(k))!=key(obj(actual.get(k)).get('intCD')) or not key(expected.get(k)) for k in ('chassis','turret','gun','engine','radio')): return None
    a=attributes(rows[cd],cfg.get('parameters'),shot_for(gun_enrich,expected.get('gun')))
    result=category_scores(a,refs.get((tier(rows[cd]),artillery(rows[cd])),{}),style)
    return result if result['score'] is not None else None

def compatibility(rows,ids,guns):
    # Use explicit compatibility only; all owned and remaining career vehicles
    # are included. Unknown/missing arrays disable sales in that category.
    mapping={'CHASSIS':'chassis','ENGINE':'engines','RADIO':'radios','FUEL_TANK':'fuelTanks'}
    used={k:set() for k in (*mapping,'TURRET','GUN','SHELL')}; unknown=set()
    for vid in ids:
        v=obj(rows.get(vid)); cm=obj(v.get('compatible_modules'))
        for cat,field in mapping.items():
            val=cm.get(field)
            if not isinstance(val,list) or any(type(x) is not int for x in val): unknown.add(cat)
            else: used[cat].update(map(str,val))
        pairs=cm.get('turrets_and_guns')
        if not isinstance(pairs,list) or not pairs:
            unknown.update(('GUN','TURRET','SHELL')); continue
        for pair in pairs:
            p=obj(pair); tid=p.get('turret'); gg=p.get('guns')
            if type(tid) is not int: unknown.add('TURRET')
            else: used['TURRET'].add(str(tid))
            if not isinstance(gg,list) or not gg or any(type(x) is not int for x in gg):
                unknown.update(('GUN','SHELL')); continue
            used['GUN'].update(map(str,gg))
    for k in used['GUN']:
        shells=obj(guns.get(k)).get('shell_ids')
        if not isinstance(shells,list) or not shells or any(type(x) is not int for x in shells): unknown.add('SHELL')
        else: used['SHELL'].update(map(str,shells))
    if 'GUN' in unknown: unknown.add('SHELL')
    return used,unknown

def retention(rows,tree,scores,refs,g,owned,known,choices,alternatives,snapshots,profiles):
    # No permanent protection for historical steps. Keep the remaining route
    # including current stage, plus any unresolved end-game alternatives.
    protected={}; remaining=set()
    def protect(k,why): protected.setdefault(k,set()).add(why)
    complete=set(choices)==set(WEIGHTS) and all(tier(rows[r['destination']])>=10 and tier(rows[r['destination']])==max((tier(rows[k]) for k in tree if artillery(rows[k])==(sty=='Artillery Support')),default=0) for sty,r in choices.items())
    for sty,r in choices.items():
        cs=snapshots[sty]; relevant=[k for k in cs['path'] if k==cs['current'] or k not in owned]
        for k in relevant:
            remaining.add(k); protect(k,sty+' career')
        # Protect the best separate X alternative, strongest natural-fit
        # endpoint and near-tied routes while the end-game choice is tested.
        # The five-point window is the already approved route stability rule.
        cohort=[a for a in alternatives[sty] if tier(rows[a['destination']])==tier(rows[r['destination']])]
        best_x=next((a for a in alternatives[sty] if tier(rows[a['destination']])==10),None)
        natural=max(cohort,key=lambda a:a.get('end',-1),default=None)
        for alt in alternatives[sty]:
            same=tier(rows[alt['destination']])==tier(rows[r['destination']])
            uncertain=alt['xp'] is None or alt['credits'] is None or alt.get('missing_fit')
            close=same and number(alt.get('rank')) is not None and number(r.get('rank')) is not None and alt['rank']>=r['rank']-5
            if (same and uncertain) or close or alt is best_x or alt is natural:
                ac=career_snapshot(alt,owned)
                for k in ac['path']:
                    if k==ac['current'] or k not in owned:
                        remaining.add(k); protect(k,sty+' end-game alternative')
    # All currently proven profitable ready vehicles stay available.
    for p in profiles:
        if p.get('ready') and p['profile'].get('n',0)>=5 and (p['profile'].get('average') or 0)>0:
            protect(p['vehicle'],'Proven credit earner')
    # Each style retains its strongest currently usable alternatives. A sale
    # requires strict domination in natural AND verified configured fit by a
    # ready equal-or-higher-tier replacement; ties and gaps remain protected.
    guns=g.catalogue.category('guns',True)
    for sty in WEIGHTS:
        eligible=[k for k in owned if artillery(rows[k])==(sty=='Artillery Support')]
        fits={k:obj(obj(scores.get(k)).get(sty)) for k in eligible}
        live={k:config_fit(rows,refs,g,owned[k],sty,guns) for k in eligible}
        for k in eligible:
            f=fits[k]; a=live[k]
            if f.get('score') is None or a is None:
                protect(k,sty+' fit incomplete'); continue
            # Do not compare mismatched data coverage as though equal.
            replacement=any(j!=k and tier(rows[j])>=tier(rows[k]) and ready(owned[j]) and
                fits[j].get('score') is not None and live[j] is not None and
                fits[j].get('coverage')==f.get('coverage') and live[j].get('coverage')==a.get('coverage') and fits[j].get('available_fields')==f.get('available_fields') and live[j].get('available_fields')==a.get('available_fields') and owned[j].get('isRented') is False and
                fits[j]['score']>f['score'] and live[j]['score']>a['score'] for j in eligible)
            if not replacement: protect(k,'Best/undominated for '+sty)
    result=[]; sales=[]
    extra=obj(g.section('account_extra')); barracks=nonneg(extra.get('free_barracks_slots')); limits=nonneg(extra.get('vehicleSellsLeft'))
    crew_ok=g.status('crew') in ('ok','empty')
    crew=obj(g.section('crew'))
    for k,v in sorted(owned.items(),key=lambda kv:(tier(rows[kv[0]]),kv[0])):
        price=verified_money(v.get('resale_price'))
        why=sorted(protected.get(k,set()))
        if not regular(rows[k]) or v.get('isPremium') is not False or v.get('isRented') is not False or v.get('isLocked') is not False:
            why.append('Special, rental or locked vehicle')
        if not complete: why.append('All ten end-game routes not verified')
        if k not in tree: why.append('Research tree membership unverified')
        if why:
            status='Keep'; reason='; '.join(why)
        else:
            checks=[]
            if price is None or price<=0: checks.append('Exact credit resale missing')
            if not isinstance(v.get('optDevices'),list) or any(x is not None for x in v['optDevices']): checks.append('Review fitted equipment and removal costs')
            if not isinstance(v.get('crew_slots'),list) or not crew_ok: checks.append('Crew not verified')
            else:
                ids=[key(obj(x).get('crew_id')) for x in v['crew_slots'] if obj(x).get('crew_id') is not None]
                if any(not obj(crew.get(i)) or key(obj(crew.get(i)).get('vehicleInvID'))!=key(v.get('invID')) for i in ids): checks.append('Crew assignment not verified')
                if ids and (barracks is None or barracks<len(ids)): checks.append('Barracks capacity not verified/sufficient')
            if limits is None or limits<1: checks.append('Vehicle sale limit unknown/reached')
            if checks:
                status='Review'; reason='; '.join(checks)
            else:
                status='Sell candidate'; reason='No current career or undominated playstyle role. Keep all crew; confirm game sale quote and retained supplies.'
                sales.append(dict(kind='vehicle',id=k,name=title(rows,k),price=price,count=1))
        result.append(('Vehicle',title(rows,k),1,status,fmt(price),reason))
    # Depot-only stock: never sell an installed item. Keep everything that
    # fits any owned vehicle, even one awaiting a vehicle sale.
    used,unknown=compatibility(rows,remaining|set(owned),g.catalogue.category('guns'))
    depot=obj(g.section('depot')); details=obj(g.section('depot_details'))
    depot_ok=g.status('depot') in ('ok','empty','partial') and g.status('depot_details') in ('ok','empty','partial')
    for cat in sorted(depot):
        data=depot[cat]
        if cat not in ('CHASSIS','ENGINE','RADIO','FUEL_TANK','TURRET','GUN','SHELL','OPTIONALDEVICE','EQUIPMENT','BATTLE_BOOSTER','CREW_BOOKS'): continue
        if not isinstance(data,dict): continue
        for k,count in sorted(data.items()):
            count=nonneg(count)
            if count is None or count<=0 or int(count)!=count: continue
            detail=obj(obj(details.get(cat)).get(k)); item=obj(detail.get('item'))
            label=name(item,'Item '+k); price=verified_money(item.get('sell')); total=price*count if price is not None else None
            if cat not in used:
                status='Keep'; reason='Reusable supplies/equipment; exact future loadouts not yet optimised'
            elif k in used[cat]:
                status='Keep'; reason='Compatible with an owned or remaining career vehicle'
            elif not complete or cat in unknown or not depot_ok or nonneg(detail.get('count'))!=count or key(item.get('intCD'))!=k or total is None or total<=0:
                status='Review'; reason='Future compatibility, quantity or verified resale incomplete'
            else:
                status='Sell candidate'; reason='No compatible owned or remaining career vehicle in verified catalogue'
                sales.append(dict(kind='depot',id=k,name=label,price=total,count=int(count)))
            result.append((cat,label,fmt(count),status,fmt(total),reason))
    return result,sorted(sales,key=lambda x:(-x['price'],x['kind'],x['id'])),complete,unknown

def data_quality(rows,tree,scores,style,candidates,choices,unknown,g,refs):
    levels={t:sum(tier(rows[k])==t and artillery(rows[k])==(style=='Artillery Support') for k in tree) for t in ENDGAME_TIERS}
    r=choices[style]; level=tier(rows[r['destination']])
    out=[('End-game horizon',str(level),'Separate tier cohorts; X and XI shown independently'),
         ('Tier X vehicles / routes',f"{levels[10]} / {sum(tier(rows[c['destination']])==10 for c in candidates)}",'Stock-based ranking'),
         ('Tier XI vehicles / routes',f"{levels[11]} / {sum(tier(rows[c['destination']])==11 for c in candidates)}",'Separate comparison'),
         ('Career weights','45 / 30 / 5 / 15 / 5','Destination / intermediate / ownership / grind / reuse'),
         ('All styles assessed',f'{len(choices)} / {len(WEIGHTS)}','Required before sale advice'),
         ('Unknown route research cost',str(sum(c['xp'] is None for c in candidates)),'Missing costs neutral, never zero'),
         ('Unknown route purchase cost',str(sum(c['credits'] is None for c in candidates)),'Price estimate excludes full preparation'),
         ('Current / potential fit','Actual / unavailable','Potential upgraded configurations require verified simulation'),
         ('Missing depot compatibility',', '.join(sorted(unknown)) or 'None detected','Uncertain categories cannot be sold'),
         ('Acquisition and transfer costs','Incomplete','Crew retraining, equipment removal, included supplies and reserve require in-game verification'),
         ('Blueprint discounts','Live owned edges only','Future vehicle blueprint discounts not assumed'),
         ('Sale prices','Live credit quotes only','No assumed resale percentage; confirm final game dialog')]
    fields=sorted({k for group in groups(style) for k,_ in group})
    ref=refs.get((level,style=='Artillery Support'),{})
    out.extend(('End-game stat: '+k,str(len(ref.get(k,[])))+' / '+str(sum(tier(rows[v])==level and artillery(rows[v])==(style=='Artillery Support') for v in tree)),'Verified stock reference coverage') for k in fields)
    for c in candidates:
        for a,b in c.get('missing_xp',[]):
            entry=('Unresolved research',title(rows,a)+' → '+title(rows,b),'Missing prerequisite chain; not estimated as zero')
            if entry not in out: out.append(entry)
    return out

def xp_profile(rows,account,vehicle,mode,style,premium):
    valid=[r for r in rows if r.get('account')==account and r.get('eligible') and r.get('vehicle')==vehicle and r.get('mode')==mode and r.get('at') is not None and nonneg(obj(r.get('personal')).get('originalXP')) is not None]
    specific=[r for r in valid if r.get('style')==style]
    valid=specific if len(specific)>=5 else valid
    valid=sorted(valid,key=lambda r:r['at'],reverse=True)[:50]
    values=[obj(r['personal'])['originalXP'] for r in valid]
    if premium: values=[math.floor(x*1.5+.5) for x in values]
    return {'n':len(values),'average':statistics.mean(values) if len(values)>=5 else None,'scope':'playstyle' if len(specific)>=5 else 'vehicle fallback'}
def grind(xp,balance,total,xrate,crate,other_rate=None):
    # Signed cash earnings; research and credit acquisition overlap only on same vehicle.
    xb=0 if xp==0 else math.ceil(xp/xrate) if xp is not None and xrate is not None and xrate>0 else None
    gap=max(0,total-balance) if total is not None and balance is not None else None
    if xb is None or gap is None: return dict(xp_battles=xb,remaining=None,stay=None,switch=None)
    if crate is None and xb>0: return dict(xp_battles=xb,remaining=None,stay=None,switch=None)
    remaining=max(0,total-(balance+xb*(crate or 0)))
    stay=xb if remaining==0 else xb+math.ceil(remaining/crate) if crate is not None and crate>0 else None
    switch=xb if remaining==0 else xb+math.ceil(remaining/other_rate) if other_rate is not None and other_rate>0 else None
    return dict(xp_battles=xb,remaining=remaining,stay=stay,switch=switch)
def quote(g,rows,target,source,owned,finance_profiles,live):
    # Gross stocking estimate uses full standard load; actual included supplies are unverified.
    v=rows[target]; e=live.get((source,target)); purchase=0 if target in owned else price_for(g,rows,target,e)
    gun=key(obj(obj(v.get('stock_modules')).get('gun')).get('compactDescr'))
    cap=nonneg(g.catalogue.item('vehicles',target,True).get('ammo_capacity'))
    shots=seq(g.catalogue.item('guns',gun,True).get('shots'))
    standard=next((s for s in shots if number(obj(s).get('defaultPortion')) is not None and s['defaultPortion']>.5),None)
    sid=key(obj(standard).get('shell_id')); unit=price_for(g,g.catalogue.category('ammunition'),sid) if sid else None
    depot=obj(g.section('depot')).get('SHELL')
    stock=nonneg(depot.get(sid,0)) if isinstance(depot,dict) and sid else None
    ammo=max(0,cap-stock)*unit if cap is not None and stock is not None and unit is not None else None
    # Verified reusable crew candidates only; never strip protected vehicles automatically.
    roles=seq(obj(v.get('vehicle_type')).get('crewRoles')); crew=obj(g.section('crew'))
    available=[c for c in crew.values() if isinstance(c,dict) and c.get('nationID')==v.get('nationID') and c.get('isDismissed') is False and (c.get('isInTank') is False or str(c.get('native_vehicle_id'))==source)]
    matches=[]; used=set()
    for rr in roles:
        primary=rr[0] if isinstance(rr,list) and rr else None
        c=next((c for c in available if c.get('role')==primary and c.get('invID') not in used),None)
        if c: used.add(c.get('invID')); matches.append(c.get('fullUserName') or str(c.get('invID')))
    # Use observed comparable same-tier reserves only as provisional estimate.
    direct=next((p['profile'].get('reserve') for p in finance_profiles if p['vehicle']==target and p['profile'].get('n',0)>=5),None)
    peers=[p['profile']['reserve'] for p in finance_profiles if p.get('tier')==tier(v) and p['profile'].get('n',0)>=5 and p['profile'].get('reserve') is not None]
    reserve=direct if direct is not None else max(peers) if peers else None
    slots=nonneg(obj(g.section('account_extra')).get('free_vehicle_slots'))
    lower=sum(x for x in (purchase,ammo,reserve) if x is not None)
    return dict(purchase=purchase,ammo=ammo,ammo_capacity=cap,ammo_stock=stock,reserve=reserve,reserve_basis='target observed' if direct is not None else 'same-tier provisional' if peers else 'unknown',crew_matches=matches,crew_slots=len(roles),slots=slots,lower=lower,complete=False,planning_total=purchase+ammo+reserve if all(x is not None for x in (purchase,ammo,reserve)) else None)
def load_state(path):
    try:
        x=json.loads(path.read_text(encoding='utf-8')); return x if x.get('schema')==1 and isinstance(x.get('accounts'),dict) else {'schema':1,'accounts':{}}
    except (OSError,ValueError,AttributeError): return {'schema':1,'accounts':{}}
def save_state(path,data):
    path.parent.mkdir(parents=True,exist_ok=True); temp=path.with_suffix('.tmp')
    temp.write_text(json.dumps(data,sort_keys=True,indent=2),encoding='utf-8'); os.replace(temp,path)
def identity(m):
    c=obj(m.sources.get('connector')); ctx=obj(m.sources.get('battle_context')); d=obj(m.sources.get('diagnostics'))
    a=ctx.get('account_key'); session=c.get('session')
    return a if session and session==ctx.get('session')==d.get('session') and c.get('game_version')==d.get('game_version') and isinstance(a,str) and re.fullmatch('[0-9a-f]{24}',a) else None
def ready(v):
    return v.get('isLocked') is False and v.get('isRented') is not True and bool(obj(obj(v.get('modules')).get('gun')).get('intCD')) and bool(seq(v.get('crew_slots'))) and all(obj(s).get('crew_id') is not None for s in v['crew_slots']) and any((nonneg(obj(s).get('count')) or 0)>0 for s in seq(v.get('shells_layout')))
def current_score(rows,ref,g,vehicle,style):
    score=config_fit(rows,ref,g,vehicle,style,g.catalogue.category('guns',True))
    return score['score'] if score else None
def action(w,title_text,detail,intent=None):
    w.next_action_title.setText(title_text); w.next_action_detail.setText(detail); w.finance_battle_intent=intent
def reset(w):
    w.prog_stamp=None; w.prog_static=None; w.prog_data=None; w.prog_last=None; w.prog_finance_target=None; w.prog_vehicle_details=[]; w.prog_route_cache=None
def make_page(w):
    p,l=page(); heading(l,'Progression','Chosen playstyle • one next action • Free XP remains optional')
    w.prog_note=label('Waiting for a verified garage snapshot',wrap=True); l.addWidget(w.prog_note)
    w.prog_tabs=QTabWidget(); l.addWidget(w.prog_tabs,1); w.prog_tables={}
    for t,h in [('Overview',['Measure','Value']),('Career',['Tier','Vehicle','Status','Natural fit']),('Technology Trees',['Nation','End-game tier','Destination','Start','Rank','Remaining XP estimate','Purchase estimate']),('Vehicles',['Vehicle','Tier','Natural fit','Current fit','Coverage','Status']),('Research',['Vehicle','Target / prerequisite','XP','Status']),('Garage & Depot',['Asset','Name','Quantity','Decision','Credit quote','Reason']),('Data Quality',['Check','Value','Meaning'])]:
        q,lay=page(); tb=w.data_table(h); w.prog_tables[t]=tb; lay.addWidget(tb,1)
        if t=='Vehicles':
            w.prog_vehicle_note=label('Select a vehicle to view its category scores.',wrap=True); lay.addWidget(w.prog_vehicle_note)
            tb.currentCellChanged.connect(lambda row,*_:vehicle_detail(w,row))
        w.prog_tabs.addTab(q,t)
    reset(w); w.add_page('Progression',p)
def vehicle_detail(w,row):
    if 0<=row<len(w.prog_vehicle_details):
        name_,s=w.prog_vehicle_details[row]
        w.prog_vehicle_note.setText(name_+' · '+'; '.join(k+': '+fmt(v) for k,v in zip(CATEGORIES,s['categories']))+' · Potential fit: not yet calculated.')
    else: w.prog_vehicle_note.setText('Select a vehicle to view its category scores.')
def coordinate(w,force=False):
    m=w.model
    if not m or not hasattr(w,'prog_tables'): return
    settings=w.settings.values; style=settings.get('playstyle'); advisor=settings.get('advisor_mode','Full Advisor')
    if m.state in ('matchmaking','battle_loading','in_battle'): return
    w.next_action_request.setVisible(advisor=='On Demand')
    profit=style=='Profit'
    if profit: w.prog_finance_target=None
    if not profit and style not in WEIGHTS: return
    a=identity(m); g=m.garage_data
    if m.state!='garage' or not a or g.status('garage') not in ('ok','empty') or g.status('research') not in ('ok','empty') or not g.catalogue.identity:
        w.prog_finance_target=None; w.prog_vehicle_details=[]; w.prog_last=None
        w.prog_note.setText('Waiting for verified live garage, research and catalogue data. Saved careers are retained.')
        for t in w.prog_tables.values(): w.set_rows(t,[])
        w.prog_stamp=None
        if not profit: action(w,'Waiting for live garage data','No spending or vehicle-switch advice from an unconfirmed snapshot.')
        return
    rows=g.catalogue.category('vehicles')
    if not rows:
        w.prog_finance_target=None; w.prog_stamp=None
        for t in w.prog_tables.values(): w.set_rows(t,[])
        if not profit: action(w,'Catalogue unavailable','Wait for the matching complete game catalogue.')
        return
    records=getattr(w,'bp_rows',[])
    finance=w.runtime.loaded.get('finance'); balance=nonneg(m.account.get('credits'))
    selected=key(m.selected.get('tank_id')); premium=finance.premium_basis(m,settings.get('strategy')) if finance else False
    usable=[r for r in records if r.get('account')==a and r.get('mode') in MODES and r.get('eligible') and r.get('at') is not None]
    mode=max(usable,key=lambda r:r['at'])['mode'] if usable else 'random_pvp'
    stamp=(str(m.root),a,g.catalogue.identity,m.garage_signature,obj(m.sources.get('diagnostics')).get('revision'),id(records),style,selected,balance,m.account.get('free_xp'),m.account.get('premium_expiry'),premium,advisor,bool(getattr(w,'finance_requested',False)))
    if stamp==w.prog_stamp and not force: return
    w.prog_stamp=stamp
    if w.prog_static is None or w.prog_static[0]!=g.catalogue.identity:
        tree=graph(rows); scores,refs=catalogue_scores(rows,tree,g.catalogue.category('guns',True)); w.prog_static=(g.catalogue.identity,tree,scores,refs)
    _,tree,scores,refs=w.prog_static
    known=unlocked_set(g)
    if known is None:
        w.prog_finance_target=None
        for t in w.prog_tables.values(): w.set_rows(t,[])
        if not profit: action(w,'Waiting for research data','Unlocks are not confirmed.')
        return
    owned={key(v.get('intCD')):v for v in m.garage if key(v.get('intCD')) in rows}
    known.update(owned); xps={str(k):v for k,v in obj(obj(g.section('research')).get('vehicle_xp')).items()}
    for k,v in owned.items():
        if nonneg(v.get('combat_xp')) is not None: xps[k]=v['combat_xp']
    if selected in owned and nonneg(m.selected.get('combat_xp')) is not None: xps[selected]=m.selected['combat_xp']
    live=live_edges(g); crew=list(obj(g.section('crew')).values())
    path=m.root/'progression'/'careers.json'; data=load_state(path); state=data['accounts'].setdefault(a,{'careers':{}}); careers=state.setdefault('careers',{})
    # Reassess all ten styles, including never-selected styles, on every
    # materially different account/research snapshot, preserving independent state.
    route_key=(a,g.catalogue.identity,m.garage_signature,tuple(sorted(owned)),tuple(sorted(known)),tuple(sorted(xps.items())),tuple(sorted((k,str(v)) for k,v in live.items())),hashlib.sha256(json.dumps(g.section('current_shop_prices'),sort_keys=True,default=str).encode()).hexdigest(),hashlib.sha256(json.dumps(crew,sort_keys=True,default=str).encode()).hexdigest())
    cached=getattr(w,'prog_route_cache',None)
    if cached is None or cached[0]!=route_key:
        choices,alternatives,snapshots=all_careers(rows,tree,scores,owned,known,xps,g,live,[c for c in crew if isinstance(c,dict)],careers)
        w.prog_route_cache=(route_key,choices,alternatives,snapshots)
    else: _,choices,alternatives,snapshots=cached
    changed=any(careers.get(sty)!=new for sty,new in snapshots.items())
    if changed:
        careers.update(snapshots)
        try: save_state(path,data)
        except OSError: logging.exception('Career state could not be saved')
    if profit:
        # Profit retains Finance's single next action. Still assess all owned
        # assets immediately without changing the selected objective.
        profiles=finance.profiles([finance.finance_row(r) for r in usable],m.garage,mode,'Profit',premium) if finance else []
        ret,sales,complete,unknown=retention(rows,tree,scores,refs,g,owned,known,choices,alternatives,snapshots,profiles)
        for t in w.prog_tables.values(): w.set_rows(t,[])
        w.prog_vehicle_details=[]
        w.set_rows(w.prog_tables['Garage & Depot'],ret)
        w.set_rows(w.prog_tables['Overview'],[('Selected objective','Profit'),('All combat careers assessed',str(len(choices))+' / 10'),('Potential verified sale quotes',fmt(sum(x['price'] for x in sales))+' credits · optional, not included in balance')])
        w.set_rows(w.prog_tables['Data Quality'],[('End-game coverage',str(len(choices))+' / 10','Sales held if incomplete'),('Missing depot compatibility',', '.join(sorted(unknown)) or 'None detected','Unknown categories held'),('Acquisition and potential fit','Incomplete','See individual career Data Quality tabs')])
        w.prog_note.setText('Profit objective · all combat careers and garage assets assessed. Finance retains the next action.')
        return
    candidates=alternatives[style]; route=choices.get(style)
    if not route:
        w.prog_finance_target=None; w.prog_last=None; w.prog_vehicle_details=[]
        for t in w.prog_tables.values(): w.set_rows(t,[])
        w.prog_note.setText('No verified suitable research route found. Other owned vehicles remain available.')
        action(w,'Review available vehicles','No confirmed progression option for '+style+'.'); return
    # Reassess using account-wide unlocks; advance to deepest owned stage on route.
    route_path=route['path']; pos=max((i for i,k in enumerate(route_path) if k in owned),default=-1)
    current=route_path[pos] if pos>=0 else None
    target=route_path[pos+1] if pos+1<len(route_path) else None
    profiles=finance.profiles([finance.finance_row(r) for r in usable],m.garage,mode,'Profit',premium) if finance else []
    # Use intended role for the career tank; alternative credit profiles retain their observed role.
    career_profiles=finance.profiles([finance.finance_row(r) for r in usable],m.garage,mode,style,premium) if finance else []
    prof=next((p['profile'] for p in career_profiles if p['vehicle']==current),{})
    xp_prof=xp_profile(usable,a,current,mode,style,premium) if current else {}
    xp_rate=xp_prof.get('average'); credit_rate=prof.get('average') if prof.get('n',0)>=5 else None
    current_known=set(known)
    if current: current_known.update(stock_ids(rows[current])); current_known.update(key(obj(x).get('intCD')) for x in obj(owned[current].get('modules')).values() if obj(x).get('intCD') is not None)
    plan=dependency_plan(rows,current,target,current_known,live) if current and target else [] if target in known else None
    cost=sum(p['xp'] for p in plan) if plan is not None else None
    available_xp=nonneg(xps.get(current)) if current else 0
    if cost==0: gap=0
    else: gap=max(0,cost-available_xp) if cost is not None and available_xp is not None else None
    q=quote(g,rows,target,current,owned,profiles,live) if target else None
    w.prog_finance_target=dict(id=target,name=title(rows,target),price=q['purchase'],unlocked=target in known,source=current,planning_total=q['planning_total'],ammo=q['ammo'],reserve=q['reserve'],account=a) if q else None
    total=q['planning_total'] if q else None
    best,reason=finance.choose(profiles,selected,style) if finance else (None,'')
    if best and (not best.get('ready') or best['profile'].get('n',0)<5 or best['profile'].get('average',0)<=0): best=None
    other=best['profile']['average'] if best else None
    gr=grind(gap,balance,total,xp_rate,credit_rate,other)
    free=nonneg(m.account.get('free_xp')); shortcut=min(free,gap) if free is not None and gap is not None else None
    alt=grind(gap-shortcut,balance,total,xp_rate,credit_rate,other) if shortcut is not None else {}
    def estimate(z):
        n=[z.get(k) for k in ('stay','switch') if z.get(k) is not None]; return min(n) if n else None
    norm=estimate(gr); fast=estimate(alt)
    optional='None needed'
    if shortcut:
        xp_saved=gr['xp_battles']-alt['xp_battles'] if gr['xp_battles'] is not None and alt.get('xp_battles') is not None else None
        optional=f'Optional {fmt(shortcut)} Free XP; '+(f'{fmt(norm-fast)} combined battles saved (estimate)' if norm is not None and fast is not None else f'{fmt(xp_saved)} research battles saved; credit requirement may still apply' if xp_saved is not None else 'battle saving not yet known')
    target_name=title(rows,target) if target else 'No further verified tier'
    current_name=title(rows,current) if current else 'Not yet owned'
    details=[('Selected playstyle',style),('Current vehicle',current_name),('End-game destination',title(rows,route['destination'])+' · Tier '+str(tier(rows[route['destination']]))),('Destination natural fit',fmt(route['end'])),('Intermediate fit',fmt(route['mid'])),('Existing progression',fmt(route['progress'])),('Grind score',fmt(route['grind'])),('Crew reuse score',fmt(route['reuse'])),('Approved branch rank',fmt(route['rank'])),('Next vehicle',target_name),('Outstanding combat XP',fmt(gap)),('Vehicle XP available',fmt(available_xp)),('XP per battle',fmt(xp_rate)),('Net credits / battle',fmt(credit_rate)),('Mode / strategy',mode+' / '+settings.get('strategy','')),('Estimated research battles',fmt(gr['xp_battles'])),('Stay in career tank (partial budget)',fmt(gr['stay'])),('Switch to credit earner (partial budget)',fmt(gr['switch'])),('Combined battles (partial budget)',fmt(norm)),('Free XP alternative',optional)]
    if q:
        details += [('Vehicle purchase',fmt(q['purchase'])),('Initial standard ammo estimate (depot deducted)',fmt(q['ammo'])),('Operating reserve',fmt(q['reserve'])+' · '+q['reserve_basis']),('Known/estimated subtotal (incomplete)',fmt(q['lower'])),('Unpriced preparation','Included supplies, consumables, crew retraining, modules/equipment, garage slot if required'),('Potential crew reuse',', '.join(q['crew_matches']) or 'None confirmed'),('Crew positions',fmt(q['crew_slots'])),('Free garage slots',fmt(q['slots']))]
    retention_rows,sales,retention_complete,unknown=retention(rows,tree,scores,refs,g,owned,known,choices,alternatives,snapshots,profiles)
    details.append(('Garage assessment','All ten playstyles assessed' if retention_complete else 'Incomplete end-game evidence; sales held'))
    details.append(('Potential verified sale quotes',fmt(sum(x['price'] for x in sales))+' credits · not included in available balance'))
    if sales: details.append(('Optional sale candidates',', '.join(x['name'] for x in sales[:5])+' · see Garage & Depot'))
    tier10=next((c for c in candidates if tier(rows[c['destination']])==10),None)
    if tier10: details.append(('Best separate Tier X route',title(rows,tier10['destination'])+' · rank '+fmt(tier10['rank'])))
    for level in ENDGAME_TIERS:
        best_fit=max((k for k in tree if tier(rows[k])==level and obj(obj(scores.get(k)).get(style)).get('score') is not None),key=lambda k:(scores[k][style]['score'],k),default=None)
        if best_fit: details.append(('Best natural fit at Tier '+str(level),title(rows,best_fit)+' · '+fmt(scores[best_fit][style]['score'])+' / 100 (stock)'))
    w.set_rows(w.prog_tables['Garage & Depot'],retention_rows)
    w.set_rows(w.prog_tables['Data Quality'],data_quality(rows,tree,scores,style,candidates,choices,unknown,g,refs))
    w.set_rows(w.prog_tables['Overview'],details)
    w.set_rows(w.prog_tables['Career'],[(tier(rows[k]),title(rows,k),'Owned' if k in owned else 'Researched' if k in known else 'Future',fmt(obj(obj(scores.get(k)).get(style)).get('score'))) for k in route_path])
    nation_best={}
    for r in candidates:
        n=rows[r['destination']].get('nationID'); t=tier(rows[r['destination']]); nt=(n,t)
        if nt not in nation_best: nation_best[nt]=r
    w.set_rows(w.prog_tables['Technology Trees'],[(NATIONS[n] if type(n) is int and 0<=n<len(NATIONS) else str(n),t,title(rows,r['destination']),title(rows,r['start']),fmt(r['rank']),fmt(r['xp']),fmt(r['credits'])) for (n,t),r in sorted(nation_best.items(),key=lambda x:(-x[0][1],-x[1]['rank']))])
    listed=set(tree)|set(owned)|{k for k,v in rows.items() if v.get('isCollectible') is True and v.get('isSecret') is False and k in known}
    vehicle_rows=[]
    for k in listed:
        s=obj(obj(scores.get(k)).get(style))
        if not s or s.get('score') is None: continue
        v=owned.get(k); cs=current_score(rows,refs,g,v,style) if v else None
        vehicle_rows.append((s['score'],k,title(rows,k),tier(rows[k]),fmt(s['score']),fmt(cs),fmt(s['coverage'])+'%', 'Owned' if v else 'Researched' if k in known else 'Locked'))
    ordered=sorted(vehicle_rows,reverse=True)
    w.prog_vehicle_details=[(r[2],scores[r[1]][style]) for r in ordered]
    w.set_rows(w.prog_tables['Vehicles'],[r[2:] for r in ordered])
    vehicle_detail(w,w.prog_tables['Vehicles'].currentRow())
    modules={k:v for cat in ('guns','turrets','engines','chassis','radios') for k,v in g.catalogue.category(cat).items()}
    allitems={**modules,**rows}
    w.set_rows(w.prog_tables['Research'],[(current_name,title(allitems,p['id']),fmt(p['xp']),'Required' if p['id']!=target else 'Next vehicle') for p in (plan or [])])
    w.prog_note.setText('End-game progression · '+mode+' · X and XI ranked separately. Stock fit; actual configured fit where verified. See Data Quality for limitations.')
    if advisor=='Information Only': action(w,'Information only','Progression information is available without automatic advice.'); return
    if advisor=='On Demand' and not getattr(w,'finance_requested',False): action(w,'Advice on demand','Select Show advice when needed.'); return
    # Prioritise a verified redundant asset only when funding/slot pressure
    # benefits advancement, or as optional immediate housekeeping otherwise.
    needed_slot=bool(q and q['slots']==0)
    short=bool(q and balance is not None and balance<q['lower'])
    candidate=next((x for x in sales if x['kind']=='vehicle'),None) if needed_slot else (sales[0] if sales else None)
    if candidate and (needed_slot or short or not target):
        qty=(' × '+str(candidate['count'])) if candidate['count']>1 else ''
        action(w,'Review sale of '+candidate['name']+qty,'Optional verified redundant asset; quoted '+fmt(candidate['price'])+' credits. Confirm actual in-game sale conditions and keep all crew/equipment. No sale is automatic. Reassess after each sale.'); return
    if not target:
        if current and not ready(owned[current]): action(w,'Prepare '+current_name,'Check crew, gun and ammunition before battle.')
        else: action(w,('Play '+current_name) if current else 'Review career','No further verified next-tier vehicle on this route; retain your chosen playstyle.')
        return
    if target not in known:
        # If XP can complete a prerequisite, advise that exact action before playing more.
        if plan and available_xp is not None and available_xp>=plan[0]['xp']:
            action(w,'Research '+title(allitems,plan[0]['id']),'Required for '+target_name+'. '+optional); return
        if current and plan is None:
            action(w,'Review research prerequisites for '+target_name,'The exported dependency chain is incomplete. Check the Data Quality tab and the in-game research screen before spending XP.'); return
        if current and ready(owned[current]):
            # Required research is actionable. Optional investments require
            # verified configuration and cost/remaining-grind evidence;
            # do not introduce an unapproved raw-power threshold.
            action(w,('Play ' if selected==current else 'Switch to ')+current_name,fmt(gap)+' XP remaining for '+target_name+'. '+optional)
        elif current: action(w,'Prepare '+current_name,'Check missing crew, gun and ammunition.')
        else: action(w,'Review research route','No owned starting vehicle confirmed.')
        return
    if q and q['slots']==0:
        action(w,'Free a garage slot','A garage slot is required for '+target_name+'. Review retention and optional sale candidates on Progression; do not sell a protected vehicle.'); return
    if q and q['purchase'] is not None and balance is not None:
        goal=total if total is not None else q['purchase']+(q['ammo'] or 0)+(q['reserve'] or 0)
        if balance<goal:
            if best:
                vid=best['vehicle']; intent=dict(vehicle=vid,style=best['style'],objective=style,purpose='Credit grinding') if selected==vid else None
                action(w,('Play ' if selected==vid else 'Switch to ')+best['name'],'Earn credits for '+target_name+'; at least '+fmt(goal-balance)+' credits short. Budget incomplete. '+reason,intent)
            elif current and ready(owned[current]): action(w,'Play '+current_name,'Earn credits for '+target_name+'; at least '+fmt(goal-balance)+' short. No better proven credit earner.')
            else: action(w,'Earn credits','Save for '+target_name+'; at least '+fmt(goal-balance)+' credits short. Purchase/preparation budget incomplete; no proven ready credit earner.')
            return
        action(w,'Review purchase of '+target_name,'Ready to advance if the in-game purchase package and preparation costs fit your balance. Purchase and reported stocking estimates covered; verify outstanding crew, included ammunition, consumables and reserve. Total acquisition cost is not confirmed.'); return
    action(w,'Review '+target_name,'Research complete; exact purchase affordability is not confirmed.')
def navigate(w,page_name):
    if page_name=='Progression': coordinate(w,True)
def register():
    return {'services':{'progression_available':lambda context:True},'views':{'coordinate_progression':coordinate},'pages':[{'name':'Progression','order':40,'build':make_page}],'hooks':{'reset':reset}}
